<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.system.mapper.tenant.SysTenantUserMapper">
    <sql id="columnList">
        <!--   id 主键  索引   -->
        id,
        <!--   tenantId      -->
        tenant_id,
        <!--   userId      -->
        user_id,
        <!--   createTime      -->
        create_time,
        <!--   createUserId      -->
        create_user_id,
        <!--   createBy      -->
        create_by
    </sql>

    <resultMap id="commonResultMap" type="com.smart.system.model.tenant.SysTenantUserPO">
        <!--   id 主键  索引   -->
        <id column="id" property="id" javaType="java.lang.Long" jdbcType="BIGINT"/>
        <!--   tenantId      -->
        <result column="tenant_id" property="tenantId" javaType="java.lang.Long" jdbcType="BIGINT"/>
        <!--   userId      -->
        <result column="user_id" property="userId" javaType="java.lang.Long" jdbcType="BIGINT"/>
        <!--   createTime      -->
        <result column="create_time" property="createTime" javaType="java.time.LocalDateTime" jdbcType="DATE"/>
        <!--   createUserId      -->
        <result column="create_user_id" property="createUserId" javaType="java.lang.Long" jdbcType="BIGINT"/>
        <!--   createBy      -->
        <result column="create_by" property="createBy" javaType="java.lang.String" jdbcType="VARCHAR"/>
    </resultMap>

    <!--  查询租户对应用户  -->
    <select id="listTenantUser" resultType="com.smart.system.pojo.dbo.tenant.SysTenantUserListDO">
        select B.id,
               B.tenant_id,
               B.create_by,
               B.create_time,
               B.create_user_id,
               B.user_id,
               A.username,
               A.full_name,
               A.email,
               A.mobile,
               c.id account_id
        from sys_user A
        join sys_tenant_user B on A.user_id = B.user_id
        left outer join sys_user_account C on a.user_id = c.user_id and B.tenant_id = c.tenant_id
            ${ew.customSqlSegment}

    </select>

    <!--  根据用户ID查询满足条件的一个租户  -->
    <select id="selectOneTenantByUser" resultType="com.smart.system.pojo.dbo.tenant.SysTenantListByUserDO">
        select A.id tenantId,
            A.tenant_code,
            A.tenant_name,
            A.tenant_short_name,
            A.platform_yn
        from sys_tenant A
        JOIN sys_tenant_user B ON A.id = B.tenant_id
        WHERE user_id = #{userId}
            AND A.delete_yn = 0
            AND A.use_yn = 1
            AND (
                (A.expire_time is null AND A.expire_time Is null)
                OR
                (A.effect_time &lt;= sysdate() AND A.expire_time &gt;= sysdate())
            )
        order by IF(B.default_yn, 1, 2), A.seq
        limit 1
    </select>
</mapper>
